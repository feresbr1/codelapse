{
  "name": "codelapse",
  "version": "1.0.0",
  "description": "Time-lapse any file's git history: watch the code evolve, click any line to see its life story, export the time-lapse as a video or GIF. Works on local and private repos.",
  "type": "module",
  "license": "MIT",
  "author": "Feres Ben Brahim",
  "homepage": "https://feresbr1.github.io/codelapse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feresbr1/codelapse.git"
  },
  "bugs": {
    "url": "https://github.com/feresbr1/codelapse/issues"
  },
  "keywords": [
    "git",
    "git-history",
    "timelapse",
    "visualization",
    "blame",
    "code-history",
    "developer-tools"
  ],
  "bin": {
    "codelapse": "dist/cli/codelapse.mjs"
  },
  "files": [
    "dist/cli/codelapse.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview --port 4179 --strictPort",
    "deploy": "node scripts/deploy-pages.mjs",
    "demos": "node scripts/make-demos.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "mediabunny": "^1.61.6",
    "preact": "^11.0.1",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
